# Frontend (React SPA) — place as .htaccess in the folder that holds index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Don't touch the backend or real files
  RewriteRule ^(backend|staging/backend)/ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else is a client-side route → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Never cache the shell — a fresh upload must show immediately
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Vite output is content-hashed → cache for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes
