# Frontend (React SPA) — place as .htaccess in the folder that holds index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Don't touch the backend or real files
  RewriteRule ^(backend|staging/backend)/ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else is a client-side route → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Vite output is content-hashed → cache for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Never cache the shell, service worker or manifest (after the rule above, so it wins) — a fresh upload must show immediately
<FilesMatch "^(index\.html|sw-v2\.js|manifest-v2\.webmanifest)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# The live site's root .htaccess sends "Permissions-Policy: microphone=()" for the whole
# domain, which blocks voice typing on /ask. Allow the microphone for this app only.
<IfModule mod_headers.c>
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes
