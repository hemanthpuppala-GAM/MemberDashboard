APP_NAME="Golden Age Wisdom"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

# Ask-a-question support lines (digits only). PRIMARY = published call/message number,
# WEB = receives all website/QR WhatsApp sends. Members' acknowledgement mail is cc'd to SUPPORT_CC_EMAIL.
SUPPORT_PRIMARY=917396112111
SUPPORT_WEB=917396119111
SUPPORT_CC_EMAIL=goldenageguruteachings@gmail.com

# Live site Supabase (Admin → People → Data sync). Service-role key: server .env only, never commit.
SUPABASE_URL=https://aicjclttdubvaslootfz.supabase.co
SUPABASE_SERVICE_KEY=
# Daily 3:00 AM IST sync (needs the cPanel cron for schedule:run). Set false at go-live.
SUPABASE_AUTO_SYNC=true

# Go live (Admin → Go live). Defaults fit the cPanel layout: the site folder is two levels above
# this backend, and members land on the main address after sign-in once live.
# GOLIVE_SITE_ROOT=/home/<user>/public_html/goldenagewisdom.org
# LIVE_URL=https://goldenagewisdom.org

# Google Drive folder of video testimonials (Admin → Testimonials → Check Drive now; daily 6:20 AM IST).
# API key restricted to the Google Drive API. Server .env only, never commit.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_TESTIMONIALS_FOLDER=17yqGgKXX2kUK5y09h2pHuNQO7IsQ5LNn

# Reading photos/PDFs of sign-up sheets at events (Claude). Server .env only, never commit.
ANTHROPIC_API_KEY=

# Extra CORS-allowed origins, comma-separated, no paths (e.g. a deployed
# staging frontend). Falls back to FRONTEND_URL when unset.
# CORS_ALLOWED_ORIGINS=https://goldenagewisdom.org

ADMIN_EMAIL=admin@goldenagewisdom.org
ADMIN_PASSWORD=ChangeMe123!

# Member OAuth (passwordless). On the server, set the GOOGLE_* keys (and GOOGLE_REDIRECT_URI).
# Local development only: OAUTH_DEV_BYPASS=true signs you in as a fake member without Google
# (ignored unless APP_ENV=local).
OAUTH_DEV_BYPASS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=golden_age_wisdom
DB_USERNAME=sail
DB_PASSWORD=password
# `docker compose up -d mysql` (uses the Sail config already in compose.yaml)
# gives you a local MySQL matching these defaults with zero extra setup.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOADS_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@goldenagewisdom.org"
MAIL_FROM_NAME="Golden Age Wisdom"
MAIL_REPLY_TO_ADDRESS="support@goldenagewisdom.org"

# Brevo transactional email API (https://api.brevo.com/v3/smtp/email).
# Set MAIL_MAILER=brevo and fill in BREVO_API_KEY (Brevo dashboard → SMTP &
# API → API Keys — not the SMTP key) to actually send through Brevo.
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Members sign in with Google only. true = also allow the demo account and email/password (local testing only).
MEMBER_PASSWORD_LOGIN=false
